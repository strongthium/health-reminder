<UserControl x:Class="Strongthium.HealthReminder.GroceriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Strongthium.HealthReminder">
  <!-- What to buy, and what it cost as it's bought. Amounts are typed in any unit and shown in one per kind. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,28" MaxWidth="1000">
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="Groceries" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" />
      </StackPanel>

      <!-- Adding -->
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="3" VerticalAlignment="Bottom" Padding="14,7" Margin="8,0,0,0" Click="HaveIt_Click"
                    ToolTip="Put it in your kitchen's stock instead of on the list">
              <TextBlock Text="I have it" />
            </Button>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="What" Style="{StaticResource Caption}" Margin="0,0,0,4" />
              <ComboBox x:Name="NameBox" IsEditable="True" IsTextSearchEnabled="True" KeyDown="Add_KeyDown" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
              <TextBlock Text="How much (optional)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
              <TextBox x:Name="QuantityBox" KeyDown="Add_KeyDown" TextChanged="Quantity_Changed"
                       ToolTip="Any amount: 2 L, 1 gallon, 500 g, 2 lb, 12, a dozen" />
            </StackPanel>
            <Button Grid.Column="2" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="16,7" Click="Add_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
                <TextBlock Text="Add" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock x:Name="QuantityHint" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- From photos, with Claude -->
      <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,12,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="PhotosButton" Click="Photos_Click" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                <TextBlock Text="From photos…" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="PhotosText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0" MaxWidth="640" />
          </StackPanel>
          <StackPanel x:Name="FoundPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="Found in the photos: untick what's wrong, and fix any names or amounts" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <ItemsControl x:Name="FoundList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:SeenRow}">
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Keep}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="That's what I have" Click="FoundToKitchen_Click" Style="{DynamicResource AccentButtonStyle}" Padding="12,6"
                      ToolTip="A photo of where they're kept: these are the amounts there are now" />
              <Button Content="I just bought these" Click="FoundBought_Click" Padding="12,6" Margin="8,0,0,0"
                      ToolTip="A receipt or a haul: add them to what's in the kitchen" />
              <Button Content="Put them on the list" Click="FoundToList_Click" Padding="12,6" Margin="8,0,0,0" />
              <Button Content="Never mind" Click="FoundCancel_Click" Padding="12,6" Margin="8,0,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="Empty" Style="{StaticResource Card}" Margin="0,12,0,0">
        <TextBlock Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap"
                   Text="The list is empty. Add what you need above, or from the meal ideas on the Eat &amp; drink page." />
      </Border>

      <!-- To buy -->
      <StackPanel x:Name="ToBuyPanel">
        <StackPanel Orientation="Horizontal" Margin="2,20,0,8">
          <TextBlock Text="To buy" Style="{StaticResource Heading}" FontSize="15" />
          <TextBlock x:Name="ToBuyCount" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
        </StackPanel>
        <ItemsControl x:Name="ToBuyList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:GroceryRow}">
              <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Shown}" Style="{StaticResource Muted}" Visibility="{Binding Shown, Converter={StaticResource VisibleIfText}}" />
                    <TextBlock Text="{Binding LastText}" Style="{StaticResource Caption}" Visibility="{Binding LastText, Converter={StaticResource VisibleIfText}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Text="Bought" Style="{StaticResource Caption}" />
                      <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Width="110" ToolTip="How much was bought, in any unit" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Text="Price" Style="{StaticResource Caption}" />
                      <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Width="90" ToolTip="What it cost (optional)" />
                    </StackPanel>
                    <Button VerticalAlignment="Bottom" Click="Bought_Click" Padding="12,6" Margin="0,0,6,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Got it" />
                      </StackPanel>
                    </Button>
                    <Button VerticalAlignment="Bottom" Click="Remove_Click" Padding="10,6" ToolTip="Take it off the list">
                      <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" />
                    </Button>
                  </StackPanel>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Problem}" Foreground="#D64541" Margin="0,4,0,0"
                             Visibility="{Binding Problem, Converter={StaticResource VisibleIfText}}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Bought -->
      <StackPanel x:Name="BoughtPanel">
        <Grid Margin="2,20,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="In the cart" Style="{StaticResource Heading}" FontSize="15" />
            <TextBlock x:Name="TotalText" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
          </StackPanel>
          <Button Grid.Column="1" Click="DoneShopping_Click" Padding="12,6" ToolTip="Clears what's bought off the list; its prices are kept for next time">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8FB;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
              <TextBlock Text="Done shopping" />
            </StackPanel>
          </Button>
        </Grid>
        <ItemsControl x:Name="BoughtList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:GroceryRow}">
              <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,4" Opacity="0.85">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,14,0" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BoughtText}" Style="{StaticResource Caption}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding PriceShown}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding UnitPriceText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                  </StackPanel>
                  <Button Grid.Column="3" VerticalAlignment="Center" Click="Undo_Click" Padding="10,6" ToolTip="Back on the list">
                    <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="13" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- In the kitchen: the stock, by the place it's kept and then by its group, a line each. -->
      <StackPanel x:Name="KitchenPanel">
        <Grid Margin="2,20,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="Your kitchen" Style="{StaticResource Heading}" FontSize="15" />
            <TextBlock x:Name="KitchenSummary" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
          </StackPanel>
          <Button Grid.Column="1" Click="Places_Click" Padding="12,6" ToolTip="Add, name and order the places things are kept: a second freezer, a pantry…">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
              <TextBlock Text="Places" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- The places, to add, name, order and take away. -->
        <Border x:Name="PlacesCard" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Where things are kept, in the order they're shown. What's in a freezer is frozen: its best-before is how long it keeps frozen."
                       Style="{StaticResource Caption}" Margin="0,0,0,8" />
            <ItemsControl x:Name="PlaceList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:PlaceRow}">
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:FoodView Icon="{Binding Icon}" Width="30" Height="30" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" LostFocus="PlaceName_LostFocus" KeyDown="PlaceName_KeyDown"
                             Margin="0,0,8,0" ToolTip="Its name: Fridge, Deep freezer, Basement shelves…" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Kinds}" DisplayMemberPath="Name" SelectedValuePath="Kind" SelectedValue="{Binding Kind, Mode=OneWay}"
                              SelectionChanged="PlaceKind_Changed" ToolTip="What kind of place it is" />
                    <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                      <Button Click="PlaceUp_Click" Padding="9,6" Margin="0,0,4,0" IsEnabled="{Binding CanUp}" ToolTip="Show it sooner">
                        <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="12" />
                      </Button>
                      <Button Click="PlaceDown_Click" Padding="9,6" Margin="0,0,4,0" IsEnabled="{Binding CanDown}" ToolTip="Show it later">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12" />
                      </Button>
                      <Button Click="PlaceDelete_Click" Padding="9,6" IsEnabled="{Binding CanDelete}"
                              ToolTip="Take it away: what's in it goes where its kind goes">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="30" Margin="0,0,10,0" />
              <TextBox x:Name="NewPlaceName" Grid.Column="1" Margin="0,0,8,0" KeyDown="NewPlace_KeyDown" ToolTip="A name for it: Deep freezer, Garage fridge…" />
              <ComboBox x:Name="NewPlaceKind" Grid.Column="2" DisplayMemberPath="Name" SelectedValuePath="Kind" />
              <Button Grid.Column="3" Click="AddPlace_Click" Padding="12,6" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                  <TextBlock Text="Add a place" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="NoKitchen" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="Nothing yet. What you buy (Got it), what's in your photos, and what you add with I have it come here, and the meals you cook take off what they use." />
        </Border>

        <ItemsControl x:Name="KitchenList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:PlaceSection}">
              <Border Style="{StaticResource Card}" Padding="10,6,10,8" Margin="0,0,0,10">
                <StackPanel>
                  <Button Style="{StaticResource Bare}" Click="PlaceToggle_Click" HorizontalContentAlignment="Stretch" Padding="4,2" ToolTip="Show or hide what's in it">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <local:FoodView Icon="{Binding Icon}" Width="30" Height="30" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Heading}" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" />
                      <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,1,0,0" />
                      <TextBlock Grid.Column="3" Text="{Binding Chevron}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                  </Button>
                  <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Visibility="{Binding Open, Converter={StaticResource VisibleIf}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:GroupSection}">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="8,10,0,2" />
                          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type local:PantryRow}">
                                <Border x:Name="Back" CornerRadius="6" Padding="4,2" Background="Transparent" ToolTip="{Binding Detail}">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" MinWidth="140" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Bare}" Click="PantryLook_Click" Width="40" Height="40" Padding="1"
                                            ToolTip="Change its picture and colour, where it's kept, its group or its best-before">
                                      <local:FoodView Icon="{Binding Icon}" Tint="{Binding Tint}" />
                                    </Button>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,8,0" FontSize="14">
                                      <Run Text="{Binding Item.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Shown, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <Border Grid.Column="2" Style="{StaticResource Chip}" Background="#C25700" Margin="0,0,10,0" Padding="6,1,6,2"
                                            Visibility="{Binding InDoubt, Converter={StaticResource VisibleIf}}"
                                            ToolTip="In doubt: count it, or say the amount is right">
                                      <TextBlock Text="check" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding When}" Foreground="{Binding WhenBrush}" VerticalAlignment="Center" TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                      <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Width="80" MinWidth="0" Margin="0,0,4,0" KeyDown="PantryCount_KeyDown"
                                               ToolTip="Count it: type how much there is now, in any unit (3, 500 g, half a loaf…), and press Enter or Set" />
                                      <!-- One place for Set (once something's typed) and Right (while it's in doubt). -->
                                      <Grid Width="52" Margin="0,0,4,0">
                                        <Button Content="Set" Click="PantrySet_Click" Padding="0,5" MinWidth="0" HorizontalAlignment="Stretch" ToolTip="Count it: this much there is now"
                                                Visibility="{Binding Typed, Converter={StaticResource VisibleIf}}" />
                                        <Button Click="PantryRight_Click" Padding="0,6" MinWidth="0" HorizontalAlignment="Stretch" ToolTip="The amount shown is right"
                                                Visibility="{Binding CanSayRight, Converter={StaticResource VisibleIf}}">
                                          <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" />
                                        </Button>
                                      </Grid>
                                      <Button Click="PantryGone_Click" Padding="9,6" MinWidth="0" ToolTip="None left: take it off">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" />
                                      </Button>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                  <Trigger SourceName="Back" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                  </Trigger>
                                </DataTemplate.Triggers>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Card}" Padding="16,12">
          <StackPanel>
            <WrapPanel>
              <CheckBox x:Name="CheckOnBox" Content="Set time aside to check the kitchen, when something's in doubt, on" VerticalAlignment="Center" Margin="0,0,8,4" Click="CheckTime_Changed" />
              <ComboBox x:Name="CheckDayBox" Width="140" Margin="0,0,8,4" SelectionChanged="CheckTime_Changed" />
              <TextBlock Text="at" VerticalAlignment="Center" Margin="0,0,8,4" />
              <local:TimeBox x:Name="CheckAtBox" Margin="0,0,0,4" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="In doubt: an amount read from a photo, used past what was counted, or not counted for two weeks. The check lists them, and counting them here puts them right. Click a picture to change it, or to move something to another place." />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
