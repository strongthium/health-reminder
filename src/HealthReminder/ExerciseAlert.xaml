<Window x:Class="Strongthium.HealthReminder.ExerciseAlert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exercise"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">
  <!-- An exercise alert: a quarter of an hour ahead, what's needed; at the time, going out or staying in, and Start. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#2E7D32" Padding="24,18">
      <StackPanel>
        <TextBlock x:Name="WhenText" Foreground="#E6FFFFFF" FontSize="13" />
        <TextBlock x:Name="TitleText" Foreground="White" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
      </StackPanel>
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
      <Button x:Name="SkipButton" Content="Not today" Click="Skip_Click" Padding="14,7" Margin="0,0,8,0" />
      <Button x:Name="SnoozeButton" Content="In 15 minutes" Click="Snooze_Click" Padding="14,7" Margin="0,0,8,0" />
      <Button x:Name="GoButton" Click="Go_Click" Style="{DynamicResource AccentButtonStyle}" Padding="22,7" />
    </StackPanel>
    <StackPanel Margin="24,16,24,16">
      <StackPanel x:Name="PlacePanel" Orientation="Horizontal" Margin="0,0,0,12">
        <TextBlock Text="Today I'm" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
        <RadioButton x:Name="OutBox" Content="going out" Click="Place_Click" Margin="0,0,16,0" />
        <RadioButton x:Name="InBox" Content="staying in" Click="Place_Click" />
      </StackPanel>
      <TextBlock x:Name="WorkoutText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
      <TextBlock Text="You'll need" FontWeight="SemiBold" Margin="0,12,0,2" />
      <TextBlock x:Name="NeedsText" TextWrapping="Wrap" />
      <TextBlock x:Name="InsulinText" Style="{StaticResource Caption}" Foreground="#C25700" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
