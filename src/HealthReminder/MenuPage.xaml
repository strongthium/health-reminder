<UserControl x:Class="Strongthium.HealthReminder.MenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Strongthium.HealthReminder">
  <!-- Meals for one: what to have by what you feel like, the week's menu, the kitchen alerts that follow from it, the
       shopping it needs in whole packs, and what to use up first. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,28" MaxWidth="1000">
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="Menu" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Meals for one: pick by what you feel like, or plan the week; the kitchen tells you when to thaw, prepare and cook"
                   Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <Border x:Name="NoMeals" Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" FontSize="14"
                     Text="There are no meal reminders yet. Work out an eating plan on the Eat &amp; drink page (or add meal reminders), and their meals come here to fill in." />
          <Button Content="Go to Eat &amp; drink" Click="EatDrink_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <!-- I feel like -->
      <TextBlock Text="I feel like…" Style="{StaticResource Heading}" FontSize="15" Margin="2,4,0,8" />
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="For" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="MealBox" MinWidth="240" SelectionChanged="Meal_Changed" Margin="0,0,0,6" />
          </WrapPanel>
          <WrapPanel x:Name="FeelPanel" Margin="0,8,0,0" />
          <TextBlock x:Name="PickedText" TextWrapping="Wrap" Margin="0,6,0,6" FontWeight="SemiBold" />
          <ItemsControl x:Name="ChoiceList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:MenuChoice}">
                <Border CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="14,10" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="{Binding Recipe.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding UsesSoon}" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" TextWrapping="Wrap"
                                 Visibility="{Binding UsesSoon, Converter={StaticResource VisibleIfText}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Steps" Click="Steps_Click" Padding="10,5" Margin="0,0,6,0" />
                      <Button Content="Have it" Click="Have_Click" Style="{DynamicResource AccentButtonStyle}" Padding="12,5" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Ideas from the kitchen, with Claude -->
      <TextBlock Text="Ideas from your kitchen" Style="{StaticResource Heading}" FontSize="15" Margin="2,20,0,8" />
      <Border Style="{StaticResource Card}" Padding="20,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="IdeasButton" Click="Ideas_Click" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                <TextBlock Text="Ask Claude" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="IdeasText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0" MaxWidth="640" />
          </StackPanel>
          <ItemsControl x:Name="IdeaList" Focusable="False" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:IdeaRow}">
                <Border CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="14,10" Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Text="{Binding Idea.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Idea.Why}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Missing to the list" Click="IdeaMissing_Click" Padding="10,5" Margin="0,0,6,0"
                              Visibility="{Binding HasMissing, Converter={StaticResource VisibleIf}}" />
                      <Button Content="Steps" Click="IdeaSteps_Click" Style="{DynamicResource AccentButtonStyle}" Padding="12,5" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Use soon -->
      <StackPanel x:Name="UseSoonPanel">
        <TextBlock Text="Use soon" Style="{StaticResource Heading}" FontSize="15" Margin="2,20,0,8" />
        <Border Style="{StaticResource Card}" Padding="20,14">
          <ItemsControl x:Name="UseSoonList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- The week -->
      <TextBlock Text="The week's menu" Style="{StaticResource Heading}" FontSize="15" Margin="2,20,0,8" />
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Each weekday's meals repeat every week. Just an idea leaves it to the meal's suggestion, with no cooking alerts; Decide on the day asks what you feel like that morning (the evening before, for breakfast)." />
          <Grid x:Name="WeekGrid" />
          <TextBlock x:Name="PicksText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <!-- Shopping -->
      <TextBlock Text="Shopping for the next 7 days" Style="{StaticResource Heading}" FontSize="15" Margin="2,20,0,8" />
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <TextBlock x:Name="NoShopping" Style="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="Nothing yet: pick recipes in the week's menu, and what they need, in the packs it comes in, shows here." />
          <ItemsControl x:Name="ShoppingList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:ShoppingRow}">
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Buy}" TextWrapping="Wrap" Margin="8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" x:Name="ShoppingButtons">
            <Button Click="AddShopping_Click" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BF;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                <TextBlock Text="Add them to my grocery list" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="ShoppingAdded" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- The kitchen -->
      <TextBlock Text="Kitchen alerts" Style="{StaticResource Heading}" FontSize="15" Margin="2,20,0,8" />
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <CheckBox x:Name="AlertsBox" Click="Options_Changed">
            <TextBlock TextWrapping="Wrap"><Run Text="Kitchen alerts" FontWeight="SemiBold" /><Run Text=": when to take food out of the freezer, when it's thawed, and when to start preparing and cooking each meal on the menu." /></TextBlock>
          </CheckBox>
          <TextBlock Text="Thawing" FontWeight="SemiBold" Margin="0,12,0,4" />
          <RadioButton x:Name="ThawFridge" Click="Options_Changed" Margin="0,2">
            <TextBlock TextWrapping="Wrap"><Run Text="In the fridge" FontWeight="SemiBold" /><Run Text=": the safest; out of the freezer the night before or that morning (moved to before bed if it would fall in the night)." /></TextBlock>
          </RadioButton>
          <RadioButton x:Name="ThawWater" Click="Options_Changed" Margin="0,2">
            <TextBlock TextWrapping="Wrap"><Run Text="In cold water" FontWeight="SemiBold" /><Run Text=": about an hour for one portion, sealed in a bag, the water changed every 30 minutes (it reminds you)." /></TextBlock>
          </RadioButton>
          <CheckBox x:Name="StepsAtStartBox" Click="Options_Changed" Margin="0,12,0,0"
                    Content="Open the recipe's steps at the side of the screen when it's time to start" />
          <CheckBox x:Name="StepsOnTopBox" Click="Options_Changed" Margin="0,6,0,0"
                    Content="Keep the steps in front of other windows" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
