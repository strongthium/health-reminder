<UserControl x:Class="Strongthium.HealthReminder.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Strongthium.HealthReminder">
  <DockPanel Margin="36,28,20,0">
    <Grid DockPanel.Dock="Top" Margin="0,0,16,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="History" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox x:Name="Filter" Width="200" SelectionChanged="Filter_Changed" Margin="0,0,8,0" />
        <ComboBox x:Name="Range" Width="150" SelectionChanged="Filter_Changed" />
      </StackPanel>
    </Grid>
    <Border DockPanel.Dock="Bottom" x:Name="VideoCheck" Style="{StaticResource Card}" Padding="16,10" Margin="0,8,16,16" Visibility="Collapsed">
      <TextBlock x:Name="VideoCheckText" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" x:Name="NoHistory" Style="{StaticResource Card}" Margin="0,0,16,0">
      <TextBlock Text="Nothing recorded in this time." Style="{StaticResource Muted}" FontSize="14" />
    </Border>

    <!-- Days and their doses, one list, so that a year of it scrolls without making every line at once. -->
    <ItemsControl x:Name="List" Focusable="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" Padding="0,0,16,16">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.Resources>
        <DataTemplate DataType="{x:Type local:HistoryDay}">
          <TextBlock Text="{Binding Text}" Style="{StaticResource Heading}" FontSize="15" Margin="2,14,0,8" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:HistoryItem}">
          <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Time}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
              <Border Grid.Column="1" Style="{StaticResource Tile}" Width="40" Height="32" Padding="4"
                      Background="{Binding Kind, Converter={StaticResource KindBrush}, ConverterParameter=tint}">
                <local:PillView Kind="{Binding Kind}" Appearance="{Binding Appearance}" Form="{Binding Form}" />
              </Border>
              <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                           Visibility="{Binding Taken, Converter={StaticResource VisibleIf}}" />
                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding Taken, Converter={StaticResource VisibleUnless}}" />
                <TextBlock Text="{Binding Result}" />
              </StackPanel>
              <Button Grid.Column="4" Margin="12,0,0,0" Padding="10,4" Visibility="{Binding HasVideo, Converter={StaticResource VisibleIf}}"
                      Click="Watch_Click" ToolTip="Play the video, after checking it hasn't been changed since it was recorded">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                  <TextBlock Text="Watch" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.Resources>
    </ItemsControl>
  </DockPanel>
</UserControl>
