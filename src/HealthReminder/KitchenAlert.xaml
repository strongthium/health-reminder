<Window x:Class="Strongthium.HealthReminder.KitchenAlert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Strongthium.HealthReminder;assembly=HealthReminder.Core"
        xmlns:local="clr-namespace:Strongthium.HealthReminder"
        Title="In the kitchen"
        Width="560" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">
  <!-- A kitchen alert: what to take out of the freezer, that it's thawed, that it's time to prepare or cook, or what
       to have, picked by what you feel like. Less insistent than a medication alarm: it rings once. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#B84A0B" Padding="24,18">
      <StackPanel>
        <TextBlock x:Name="WhenText" Foreground="#E6FFFFFF" FontSize="13" />
        <TextBlock x:Name="TitleText" Foreground="White" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
      <Button x:Name="StepsButton" Content="Show the steps" Click="Steps_Click" Padding="14,7" Margin="0,0,8,0" />
      <Button x:Name="SnoozeButton" Content="In 10 minutes" Click="Snooze_Click" Padding="14,7" Margin="0,0,8,0" />
      <Button x:Name="DoneButton" Content="Done" Click="Done_Click" Style="{DynamicResource AccentButtonStyle}" Padding="22,7" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,16,24,16">
        <TextBlock x:Name="DetailText" TextWrapping="Wrap" FontSize="15" />

        <!-- What it needs -->
        <StackPanel x:Name="IngredientsPanel" Margin="0,14,0,0">
          <TextBlock x:Name="RecipeText" FontWeight="SemiBold" />
          <ItemsControl x:Name="IngredientList" Focusable="False" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type core:FoodItem}">
                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,1" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Choosing by what you feel like -->
        <StackPanel x:Name="ChoosePanel" Margin="0,12,0,0">
          <TextBlock Text="I feel like…" FontWeight="SemiBold" Margin="0,0,0,6" />
          <WrapPanel x:Name="FeelPanel" />
          <ItemsControl x:Name="RecipeList" Focusable="False" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:RecipeChoice}">
                <Button Click="Pick_Click" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="12,8" Margin="0,0,0,6">
                  <StackPanel>
                    <TextBlock Text="{Binding Recipe.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NoneText" Style="{StaticResource Muted}" Text="Nothing for this meal matches; pick another." Visibility="Collapsed" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
