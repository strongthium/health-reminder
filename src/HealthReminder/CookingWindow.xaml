<Window x:Class="Strongthium.HealthReminder.CookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Strongthium.HealthReminder"
        Title="Cooking" Width="420" MinWidth="320" MinHeight="300"
        WindowStartupLocation="Manual" ShowInTaskbar="True">
  <!-- The recipe at the side of the screen while cooking: what it needs, ticked off, and the steps with a timer for
       each one that takes time. It can stay in front of other windows. -->
  <DockPanel>
    <Border x:Name="Header" DockPanel.Dock="Top" Background="#B84A0B" Padding="18,14">
      <StackPanel>
        <TextBlock x:Name="NameText" Foreground="White" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="WhenText" Foreground="#E6FFFFFF" Margin="0,2,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="18,10" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="14,5" />
        <Button x:Name="FinishedButton" DockPanel.Dock="Right" Content="Done" Click="Finished_Click" Style="{DynamicResource AccentButtonStyle}" Padding="16,5" Margin="0,0,8,0" Visibility="Collapsed" />
        <CheckBox x:Name="OnTopBox" Content="Keep on top" ToolTip="Keep these steps over other windows" VerticalAlignment="Center" Click="OnTop_Click" />
      </DockPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="NeedsHeading" Text="You'll need" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ItemsControl x:Name="IngredientList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Steps" FontWeight="SemiBold" Margin="0,14,0,4" />
        <ItemsControl x:Name="StepList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:StepItem}">
              <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Background="{Binding Background}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="0,1,6,0" MinWidth="0" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Grid.Column="2" Content="{Binding TimerText}" Click="Timer_Click" Padding="10,4" VerticalAlignment="Top"
                          Visibility="{Binding HasTimer, Converter={StaticResource VisibleIf}}" MinWidth="76" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoteText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="A food thermometer in the thickest part tells when meat and fish are cooked safely; colour doesn't." />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
