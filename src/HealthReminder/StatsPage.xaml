<UserControl x:Class="Strongthium.HealthReminder.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Strongthium.HealthReminder">
  <UserControl.Resources>
    <Style x:Key="TileNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Stat" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="ChartTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Swatch" TargetType="Border">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,28" MaxWidth="1000">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Stats" Style="{StaticResource PageTitle}" />
          <TextBlock Text="How the days have gone: reminders done and missed, cigarettes, drinks and food" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="CountingText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="RangeBox" MinWidth="150" SelectionChanged="Range_Changed" />
          <Button Click="Print_Click" Padding="12,6" Margin="8,0,0,0" ToolTip="Print these stats and charts, or save them as a PDF">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
              <TextBlock Text="Print" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- What stands out -->
      <Border Style="{StaticResource Card}" Padding="20,14">
        <ItemsControl x:Name="NoteList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:NoteRow}">
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Brush}" VerticalAlignment="Top" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Style="{StaticResource Muted}" />
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- The numbers -->
      <WrapPanel Margin="0,16,0,0">
        <Border Style="{StaticResource Stat}">
          <StackPanel>
            <TextBlock x:Name="DoneText" Style="{StaticResource TileNumber}" />
            <TextBlock x:Name="DoneLabel" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Stat}">
          <StackPanel>
            <TextBlock x:Name="MissedText" Style="{StaticResource TileNumber}" />
            <TextBlock x:Name="MissedLabel" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Stat}">
          <StackPanel>
            <TextBlock x:Name="SmokesText" Style="{StaticResource TileNumber}" />
            <TextBlock Text="cigarettes a day" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Stat}">
          <StackPanel>
            <TextBlock x:Name="GapText" Style="{StaticResource TileNumber}" />
            <TextBlock Text="between cigarettes" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Stat}">
          <StackPanel>
            <TextBlock x:Name="DrinksText" Style="{StaticResource TileNumber}" />
            <TextBlock x:Name="DrinksLabel" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Stat}">
          <StackPanel>
            <TextBlock x:Name="KcalText" Style="{StaticResource TileNumber}" />
            <TextBlock Text="kcal a day, about" Style="{StaticResource Muted}" />
          </StackPanel>
        </Border>
      </WrapPanel>

      <!-- The charts, a day a bar, today last -->
      <Border Style="{StaticResource Card}" Margin="0,8,0,0">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource Swatch}" Background="{x:Static local:StatsReport.DoneBrush}" />
              <TextBlock Text="Done" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0" />
              <Border Style="{StaticResource Swatch}" Background="{x:Static local:StatsReport.SkippedBrush}" />
              <TextBlock Text="Skipped" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0" />
              <Border Style="{StaticResource Swatch}" Background="{x:Static local:StatsReport.MissedBrush}" />
              <TextBlock Text="Missed" Style="{StaticResource Muted}" FontSize="12" />
            </StackPanel>
            <TextBlock Text="Reminders each day" Style="{StaticResource ChartTitle}" />
          </DockPanel>
          <TextBlock x:Name="DoneSummary" Style="{StaticResource Caption}" Margin="0,2,0,12" />
          <local:DayBars x:Name="DoneChart" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Cigarettes each day" Style="{StaticResource ChartTitle}" />
          <TextBlock x:Name="SmokeSummary" Style="{StaticResource Caption}" Margin="0,2,0,12" />
          <local:DayBars x:Name="SmokeChart" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Average time between cigarettes" Style="{StaticResource ChartTitle}" />
          <TextBlock x:Name="GapSummary" Style="{StaticResource Caption}" Margin="0,2,0,12" />
          <local:DayBars x:Name="GapChart" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource Swatch}" Background="{x:Static local:StatsReport.DrinkBrush}" />
              <TextBlock Text="Done" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0" />
              <Border Style="{StaticResource Swatch}" Background="{x:Static local:StatsReport.DrinkLeftBrush}" />
              <TextBlock Text="Not done" Style="{StaticResource Muted}" FontSize="12" />
            </StackPanel>
            <TextBlock Text="Drinks each day" Style="{StaticResource ChartTitle}" />
          </DockPanel>
          <TextBlock x:Name="DrinkSummary" Style="{StaticResource Caption}" Margin="0,2,0,12" />
          <local:DayBars x:Name="DrinkChart" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="Calories each day" Style="{StaticResource ChartTitle}" />
          <TextBlock x:Name="KcalSummary" Style="{StaticResource Caption}" Margin="0,2,0,12" />
          <local:DayBars x:Name="KcalChart" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
