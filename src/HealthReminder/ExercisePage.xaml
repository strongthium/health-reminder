<UserControl x:Class="Strongthium.HealthReminder.ExercisePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Strongthium.HealthReminder">
  <!-- Exercise from no equipment up: today's session (going out or staying in), the week against the 150 minutes, and
       the plan: the days and time set aside, how long, how fit, where, and what equipment there is. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,28" MaxWidth="1000">
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="Exercise" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Time set aside each day, with or without equipment, going out or staying in" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" />
      </StackPanel>

      <!-- Today -->
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <TextBlock x:Name="TodayHeading" Style="{StaticResource Heading}" FontSize="15" />
          <StackPanel x:Name="TodayPanel" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton x:Name="OutBox" Content="Going out" Click="Place_Click" Margin="0,0,16,0" />
              <RadioButton x:Name="InBox" Content="Staying in" Click="Place_Click" />
            </StackPanel>
            <TextBlock x:Name="WorkoutText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            <TextBlock x:Name="NeedsText" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ItemsControl x:Name="StepsList" Focusable="False" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="StartButton" Content="Start" Click="Start_Click" Style="{DynamicResource AccentButtonStyle}" Padding="20,6" />
              <Button x:Name="DoneButton" Content="I did it" Click="Done_Click" Padding="14,6" Margin="8,0,0,0" />
              <TextBlock x:Name="DoneText" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="SafetyText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
          <TextBlock x:Name="InsulinText" Style="{StaticResource Caption}" Foreground="#C25700" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Border>

      <!-- The week -->
      <TextBlock Text="This week" Style="{StaticResource Heading}" FontSize="15" Margin="2,20,0,8" />
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WeekText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
            <ProgressBar Grid.Column="1" x:Name="WeekProgress" Maximum="150" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl x:Name="WeekList" Focusable="False" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:WeekRow}">
                <Grid Margin="0,3" Opacity="{Binding Opacity}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Day}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                             Visibility="{Binding Done, Converter={StaticResource VisibleIf}}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- The plan -->
      <TextBlock Text="Your plan" Style="{StaticResource Heading}" FontSize="15" Margin="2,20,0,8" />
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <TextBlock Text="Days" FontWeight="SemiBold" Margin="0,0,0,6" />
          <WrapPanel x:Name="DayPanel" />
          <WrapPanel Margin="0,12,0,0">
            <StackPanel Margin="0,0,24,8">
              <TextBlock Text="At" FontWeight="SemiBold" Margin="0,0,0,4" />
              <local:TimeBox x:Name="AtBox" />
            </StackPanel>
            <StackPanel Margin="0,0,24,8">
              <TextBlock Text="For" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ComboBox x:Name="MinutesBox" Width="140" />
            </StackPanel>
            <StackPanel Margin="0,0,24,8">
              <TextBlock Text="To start with, I'm" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ComboBox x:Name="LevelBox" Width="230">
                <ComboBoxItem Content="Just starting out" />
                <ComboBoxItem Content="Somewhat active" />
                <ComboBoxItem Content="Fit" />
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="Usually" FontWeight="SemiBold" Margin="0,0,0,4" />
              <ComboBox x:Name="WhereBox" Width="230">
                <ComboBoxItem Content="Ask me each time" />
                <ComboBoxItem Content="Going out" />
                <ComboBoxItem Content="Staying in" />
              </ComboBox>
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="What I have (none is needed)" FontWeight="SemiBold" Margin="0,8,0,6" />
          <WrapPanel x:Name="GearPanel" />
          <CheckBox x:Name="AlertsBox" Content="Alerts: 15 minutes before, with what's needed, and at the time" Margin="0,12,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="Save the plan" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
            <Button x:Name="RestartButton" Content="Start over from the beginning" Click="Restart_Click" Padding="12,6" Margin="8,0,0,0"
                    ToolTip="Sessions get harder every three weeks from the start; this starts again at the level chosen" />
            <TextBlock x:Name="SavedText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
