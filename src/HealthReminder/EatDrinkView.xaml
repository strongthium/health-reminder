<UserControl x:Class="Strongthium.HealthReminder.EatDrinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Strongthium.HealthReminder">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,28" MaxWidth="1000">
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="Eat &amp; drink" Style="{StaticResource PageTitle}" />
      <TextBlock Text="Reminders to eat and drink, worked out for your body" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" />
        <ColumnDefinition Width="6*" />
      </Grid.ColumnDefinitions>
      <!-- An Auto row, not the implicit star one: in a ScrollViewer a star row kept the plan card at its first height
           when the plan appeared in it. -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" VerticalAlignment="Top" Padding="24">
        <StackPanel>
          <TextBlock Text="About you" Style="{StaticResource Heading}" />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"
                     Text="Health Reminder can remind you when to eat and drink, with amounts worked out for your body. Your measurements stay on this computer." />

          <WrapPanel Margin="0,0,0,8">
            <RadioButton x:Name="Metric" Content="cm and kg" Margin="0,0,16,4" Click="Units_Changed" />
            <RadioButton x:Name="Imperial" Content="feet, inches and pounds" Margin="0,0,0,4" Click="Units_Changed" />
          </WrapPanel>

          <TextBlock Text="Sex" Style="{StaticResource Label}" />
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="Female" Content="Female" Margin="0,0,16,0" Click="Sex_Changed" />
            <RadioButton x:Name="Male" Content="Male" Click="Sex_Changed" />
          </StackPanel>
          <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                     Text="Your body's sex, not gender: energy and water needs follow physiology." />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Height" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
              <local:NumberBox x:Name="HeightCm" Minimum="100" Maximum="250" Width="130" />
              <TextBlock x:Name="CmLabel" Text="cm" VerticalAlignment="Center" Margin="6,0,0,0" />
              <local:NumberBox x:Name="HeightFt" Minimum="3" Maximum="8" Width="110" />
              <TextBlock x:Name="FtLabel" Text="ft" VerticalAlignment="Center" Margin="6,0,10,0" />
              <local:NumberBox x:Name="HeightIn" Minimum="0" Maximum="11" Width="110" />
              <TextBlock x:Name="InLabel" Text="in" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Weight" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
              <local:NumberBox x:Name="WeightBox" Minimum="30" Maximum="770" Width="130" />
              <TextBlock x:Name="WeightUnit" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="Age" VerticalAlignment="Center" />
            <local:NumberBox Grid.Row="2" Grid.Column="1" x:Name="AgeBox" Minimum="1" Maximum="120" Width="130" HorizontalAlignment="Left" Margin="0,4" />
            <TextBlock Grid.Row="3" Text="Activity" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ActivityBox" Margin="0,4" />
            <TextBlock Grid.Row="4" x:Name="PregnancyLabel" Text="Pregnancy" VerticalAlignment="Center" />
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="PregnancyBox" Margin="0,4" />
            <TextBlock Grid.Row="5" Text="I get up at" VerticalAlignment="Center" />
            <local:TimeBox Grid.Row="5" Grid.Column="1" x:Name="WakeBox" Margin="0,4" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="6" Text="I go to bed at" VerticalAlignment="Center" />
            <local:TimeBox Grid.Row="6" Grid.Column="1" x:Name="SleepBox" Margin="0,4" HorizontalAlignment="Left" />
          </Grid>

          <TextBlock Text="Your weight" Style="{StaticResource Label}" Margin="0,16,0,4" />
          <WrapPanel>
            <RadioButton x:Name="GoalKeep" Content="Keep it" Margin="0,0,16,4" Click="Goal_Changed" />
            <RadioButton x:Name="GoalLose" Content="Lose weight" Margin="0,0,16,4" Click="Goal_Changed" />
            <RadioButton x:Name="GoalGain" Content="Gain weight" Margin="0,0,0,4" Click="Goal_Changed" />
          </WrapPanel>
          <StackPanel x:Name="PacePanel" Margin="0,4,0,0">
            <ComboBox x:Name="PaceBox" HorizontalAlignment="Left" MinWidth="300" />
            <TextBlock x:Name="PaceHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
          <TextBlock x:Name="GoalProblem" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />

          <Button Content="Work out my plan" Style="{DynamicResource AccentButtonStyle}" Click="Plan_Click" Margin="0,16,0,0" HorizontalAlignment="Left" />
          <TextBlock x:Name="ProblemText" Foreground="#D64541" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" VerticalAlignment="Top" Padding="24">
        <StackPanel>
          <TextBlock Text="Your plan" Style="{StaticResource Heading}" />
          <TextBlock x:Name="NoPlan" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Fill in the form and choose Work out my plan. You'll see it here before anything is set up." />
          <StackPanel x:Name="PlanPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border CornerRadius="8" Background="#1FD64541" Padding="12" Margin="0,0,5,0">
                <StackPanel>
                  <TextBlock x:Name="CaloriesText" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock x:Name="CaloriesLabel" Text="to eat a day" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" CornerRadius="8" Background="#1F3E7BD6" Padding="12" Margin="5,0,0,0">
                <StackPanel>
                  <TextBlock x:Name="WaterText" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="to drink a day" Style="{StaticResource Muted}" />
                </StackPanel>
              </Border>
            </Grid>
            <Border x:Name="GoalBox" CornerRadius="8" Background="#1F2E7D32" Padding="12" Margin="0,10,0,0">
              <TextBlock x:Name="GoalText" TextWrapping="Wrap" />
            </Border>
            <TextBlock x:Name="BasisText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8" />
            <ItemsControl x:Name="PlanList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:PlanRow}">
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <local:PillView Grid.Column="1" Kind="{Binding Kind}" Width="30" Height="26" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="2" Margin="6,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding Idea}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                 Visibility="{Binding Idea, Converter={StaticResource VisibleIfText}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Amount}" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,4,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,6,0,0">
              <Button Click="OtherIdeas_Click" Margin="0,0,8,6" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                  <TextBlock Text="Other meal ideas" />
                </StackPanel>
              </Button>
              <Button Click="AddGroceries_Click" Margin="0,0,8,6" Padding="12,5">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7BF;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                  <TextBlock Text="Add them to my grocery list" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock x:Name="GroceryText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Meal ideas are everyday food in household amounts, close to each meal's calories; brands differ, so they're a guide. Swap anything for something like it." />
            <ItemsControl x:Name="NotesList" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="12" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="UseButton" Content="Use this plan" Style="{DynamicResource AccentButtonStyle}" Click="Use_Click" />
              <TextBlock x:Name="UsedText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="RemoveButton" Content="Stop the eating and drinking reminders" Click="Remove_Click" Margin="0,12,0,0" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
