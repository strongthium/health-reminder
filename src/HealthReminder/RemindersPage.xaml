<UserControl x:Class="Strongthium.HealthReminder.RemindersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Strongthium.HealthReminder">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,28" MaxWidth="1000">
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Reminders" Style="{StaticResource PageTitle}" />
          <TextBlock x:Name="CountText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" Padding="16,8" Click="Add_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
            <TextBlock Text="Add reminder" />
          </StackPanel>
        </Button>
      </Grid>

      <Border x:Name="NoReminders" Style="{StaticResource Card}" Margin="0,8,0,0">
        <TextBlock Text="No reminders yet. Add one with the button above." Style="{StaticResource Muted}" FontSize="14" />
      </Border>

      <ItemsControl x:Name="Sections" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:ReminderSection}">
            <StackPanel Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                <Ellipse Width="10" Height="10" Fill="{Binding Group, Converter={StaticResource KindBrush}}" VerticalAlignment="Center" Margin="0,1,10,0" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="15" />
                <TextBlock Text="{Binding Count}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:ReminderItem}">
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,6" Opacity="{Binding Opacity}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="96" Height="68" VerticalAlignment="Top">
                          <Border Style="{StaticResource Tile}" Background="{Binding Kind, Converter={StaticResource KindBrush}, ConverterParameter=tint}"
                                  Visibility="{Binding HasPhoto, Converter={StaticResource VisibleUnless}}">
                            <local:PillView Kind="{Binding Kind}" Appearance="{Binding Appearance}" Form="{Binding Form}" />
                          </Border>
                          <Border CornerRadius="8" Background="White" ClipToBounds="True" Visibility="{Binding HasPhoto, Converter={StaticResource VisibleIf}}">
                            <Image Source="{Binding Photo}" Stretch="UniformToFill" />
                          </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                          <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Chip}" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="0,0,6,0">
                              <TextBlock Text="{Binding KindText}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#5F6B76" Margin="0,0,6,0" Visibility="{Binding Planned, Converter={StaticResource VisibleIf}}">
                              <TextBlock Text="Eating plan" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#C62828" Margin="0,0,6,0" Visibility="{Binding RecordVideo, Converter={StaticResource VisibleIf}}">
                              <TextBlock Text="On video" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="#5F6B76" Visibility="{Binding Paused, Converter={StaticResource VisibleIf}}">
                              <TextBlock Text="Paused" />
                            </Border>
                          </WrapPanel>
                          <TextBlock Text="{Binding ScheduleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                          <TextBlock Text="{Binding Look}" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding Look, Converter={StaticResource VisibleIfText}}" />
                          <TextBlock Text="{Binding Ids}" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding Ids, Converter={StaticResource VisibleIfText}}" />
                          <TextBlock Text="{Binding SupplyText}" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding SupplyText, Converter={StaticResource VisibleIfText}}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SupplyLow}" Value="True">
                                    <Setter Property="Foreground" Value="#C25700" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Click="Edit_Click" Padding="12,6">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Edit" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
