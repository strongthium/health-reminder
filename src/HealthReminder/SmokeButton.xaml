<Window x:Class="Strongthium.HealthReminder.SmokeButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log a cigarette"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="WidthAndHeight">
  <!-- A button that stays on top of everything: a click logs a cigarette (or, timed, starts and finishes one); it can
       be dragged anywhere. Right-click for the rest. -->
  <!-- A set size at the left: Windows keeps a window wider than this, and the rest of it is see-through and clicks
       through. -->
  <Grid Margin="6" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Border x:Name="Face" Width="56" Height="56" CornerRadius="28" Background="#37474F" BorderBrush="#33FFFFFF" BorderThickness="1"
            Cursor="Hand">
      <Border.Effect>
        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" />
      </Border.Effect>
      <Grid>
        <!-- A cigarette: white paper, an orange filter, a glowing end. -->
        <Canvas x:Name="Cigarette" Width="36" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Rectangle Canvas.Left="0" Width="10" Height="8" Canvas.Top="1" RadiusX="1.5" RadiusY="1.5" Fill="#E8A35C" />
          <Rectangle Canvas.Left="10" Width="21" Height="8" Canvas.Top="1" Fill="#FAFAFA" />
          <Rectangle Canvas.Left="31" Width="4" Height="8" Canvas.Top="1" RadiusX="1.5" RadiusY="1.5" Fill="#FF6E40" />
        </Canvas>
        <TextBlock x:Name="TimerText" Foreground="White" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Visibility="Collapsed" />
      </Grid>
    </Border>
    <Border x:Name="Badge" MinWidth="20" Height="20" CornerRadius="10" Background="#C62828" BorderBrush="White" BorderThickness="1.5"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Padding="4,0" IsHitTestVisible="False">
      <TextBlock x:Name="CountText" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
