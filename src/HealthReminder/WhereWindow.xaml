<Window x:Class="Strongthium.HealthReminder.WhereWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Strongthium.HealthReminder"
        Title="Put it away"
        SizeToContent="Height" Width="600"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- Something new to the kitchen: the place it's put in, and the group it's shown in there. -->
  <StackPanel Margin="24,20,24,20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <local:FoodView x:Name="Preview" Width="56" Height="56" />
      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="NameText" Style="{StaticResource Title}" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
      </StackPanel>
    </Grid>

    <TextBlock Text="Where does it go?" Style="{StaticResource Label}" Margin="0,18,0,8" />
    <WrapPanel x:Name="PlacePanel" />
    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
               Text="In a freezer, it's frozen from today, and its best-before is how long it keeps frozen. Next time it's new to the kitchen, it goes where you put it now." />

    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
      <TextBlock Text="Shown with" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ComboBox x:Name="GroupBox" Width="200" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" IsCancel="True" Padding="16,6" />
    </StackPanel>
  </StackPanel>
</Window>
