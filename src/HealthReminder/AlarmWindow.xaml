<Window x:Class="Strongthium.HealthReminder.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Strongthium.HealthReminder"
        Title="Health Reminder"
        Width="720" SizeToContent="Height" MaxHeight="940"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ResizeMode="NoResize">
  <!-- In the colour of what is due (KindLook): teal for medication, purple for an injection, rose for blood sugar, blue
       for the other checks and for water, orange for a meal; each dose on it has a band of its own colour. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" x:Name="Band" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="64" Height="64" CornerRadius="32" Background="White" Margin="0,0,18,0" VerticalAlignment="Center">
          <local:PillView x:Name="BandPicture" Margin="12" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
          <TextBlock x:Name="Subtitle" FontSize="14" Foreground="White" Opacity="0.88" Margin="0,2,0,0" />
        </StackPanel>
        <Button Grid.Column="2" x:Name="SilenceButton" Style="{StaticResource ColorButton}" Background="#33FFFFFF" Padding="14,8"
                Visibility="Collapsed" VerticalAlignment="Center" Click="Silence_Click" ToolTip="Stop the sound and keep this window open">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74F;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Silence" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" x:Name="AllBar" Padding="16,4,16,16" Visibility="Collapsed">
      <Button x:Name="AllButton" Style="{StaticResource ColorButton}" HorizontalAlignment="Stretch" Padding="0,13" FontSize="16" Click="All_Click" />
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="DoseList" Margin="16,16,16,4" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:AlarmItem}">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="6" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding Kind, Converter={StaticResource KindBrush}}" CornerRadius="7,0,0,7" />
                <Grid Grid.Column="1" Margin="18,18,20,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <StackPanel Margin="0,0,20,0" VerticalAlignment="Top">
                    <Border Style="{StaticResource Tile}" Width="180" Height="{Binding PictureHeight}" Padding="12"
                            Background="{Binding Kind, Converter={StaticResource KindBrush}, ConverterParameter=tint}">
                      <local:PillView Kind="{Binding Kind}" Appearance="{Binding Appearance}" Form="{Binding Form}" Count="{Binding Count}" />
                    </Border>
                    <Border Width="180" Height="140" CornerRadius="8" Background="White" ClipToBounds="True" Margin="0,8,0,0"
                            Visibility="{Binding HasPhoto, Converter={StaticResource VisibleIf}}">
                      <Image Source="{Binding Photo}" Stretch="Uniform" />
                    </Border>
                  </StackPanel>

                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                      <Border Style="{StaticResource Chip}" Background="{Binding Kind, Converter={StaticResource KindBrush}}">
                        <TextBlock Text="{Binding KindText}" />
                      </Border>
                      <TextBlock Text="{Binding DueText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Instruction}" FontSize="19" TextWrapping="Wrap" Margin="0,2,0,0" />

                    <Border CornerRadius="6" Background="#C62828" Padding="12,8" Margin="0,10,0,0"
                            Visibility="{Binding MissedText, Converter={StaticResource VisibleIfText}}">
                      <TextBlock Text="{Binding MissedText}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <Border CornerRadius="6" Background="#33C25700" Padding="12,8" Margin="0,8,0,0"
                            Visibility="{Binding SupplyText, Converter={StaticResource VisibleIfText}}">
                      <TextBlock Text="{Binding SupplyText}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding Look, Converter={StaticResource VisibleIfText}}">
                      <TextBlock Text="LOOK FOR" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Look}" FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding Idea, Converter={StaticResource VisibleIfText}}">
                      <TextBlock Text="FOR EXAMPLE" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Idea}" FontSize="15" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding IsInjection, Converter={StaticResource VisibleIf}}">
                      <TextBlock Text="Site" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                      <ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding Site}" MinWidth="200" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding IsCheck, Converter={StaticResource VisibleIf}}">
                      <TextBlock Text="Reading" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="140" FontSize="16" ToolTip="{Binding ValueHint}" />
                      <TextBlock Text="{Binding ValueUnit}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasProgress, Converter={StaticResource VisibleIf}}">
                      <ProgressBar Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue, Mode=OneWay}" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding Progress}" Style="{StaticResource Muted}" />
                    </StackPanel>

                    <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding Notes, Converter={StaticResource VisibleIfText}}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" MaxWidth="380" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                    <Button Content="Skip" Click="Skip_Click" Margin="0,0,8,0" Padding="16,8" />
                    <Button Content="{Binding SnoozeText}" Click="Snooze_Click" Margin="0,0,8,0" Padding="16,8" />
                    <Button Content="{Binding DoneText}" Style="{StaticResource ColorButton}" Background="{Binding Kind, Converter={StaticResource KindBrush}}"
                            MinWidth="130" Padding="24,9" Click="Done_Click" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
