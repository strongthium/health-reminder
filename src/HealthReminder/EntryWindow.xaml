<Window x:Class="Strongthium.HealthReminder.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Is this right?"
        SizeToContent="Height" Width="520"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- A line typed under What that could be read more than one way: how it was read, to put right. -->
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="TypedText" Style="{StaticResource Title}" TextWrapping="Wrap" />
    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="This is how it was read. Change anything that's wrong." />

    <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,16,0,3" />
    <TextBox x:Name="NameBox" />
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="Brand or kind" Style="{StaticResource Caption}" Margin="0,0,0,3" />
        <TextBox x:Name="NoteBox" ToolTip="Which one it is: Schneiders, Chudleys, the 2% one…" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="How much" Style="{StaticResource Caption}" Margin="0,0,0,3" />
        <TextBox x:Name="QuantityBox" ToolTip="Any amount: 2 L, 1 gallon, 500 g, 2 lb, 12, a dozen" />
      </StackPanel>
    </Grid>

    <Grid Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="Keep it as typed" Click="AsTyped_Click" Padding="14,6" HorizontalAlignment="Left" ToolTip="All of it is the name" />
      <Button Grid.Column="1" Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
      <Button Grid.Column="2" Content="That's right" Click="Right_Click" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
    </Grid>
  </StackPanel>
</Window>
