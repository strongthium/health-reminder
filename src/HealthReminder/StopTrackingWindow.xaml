<Window x:Class="Strongthium.HealthReminder.StopTrackingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stop tracking"
        SizeToContent="Height" Width="520"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- What stopping does, whether medication still rings, and the offer to start the stats afresh. -->
  <StackPanel Margin="24,20,24,20">
    <TextBlock Text="Stop tracking?" Style="{StaticResource Title}" />
    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
               Text="Until you start again, nothing counts as missed, and meals, drinks, checks, exercise and kitchen alerts don't ring. Whatever you log yourself is still kept." />

    <CheckBox x:Name="MedicationBox" Content="Keep ringing for medication" IsChecked="True" Margin="0,16,0,0" />
    <TextBlock x:Name="MedicationNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,2,0,0"
               Text="Unticked, nothing reminds you to take it while tracking is stopped." />

    <CheckBox x:Name="ResetBox" Content="Reset the stats, to start fresh" Margin="0,14,0,0" />
    <TextBlock x:Name="StaysText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,2,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" IsCancel="True" Padding="16,6" />
      <Button Content="Stop tracking" Click="Stop_Click" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
