<UserControl x:Class="Strongthium.HealthReminder.TodayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Strongthium.HealthReminder"
             xmlns:core="clr-namespace:Strongthium.HealthReminder;assembly=HealthReminder.Core">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,28" MaxWidth="1000">
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Today" Style="{StaticResource PageTitle}" />
          <TextBlock x:Name="DateText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" Padding="16,8" Click="Add_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
            <TextBlock Text="Add reminder" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- How the day is going. -->
      <Border x:Name="Summary" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel MinWidth="200">
            <TextBlock x:Name="ProgressText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="NextText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
          </StackPanel>
          <ProgressBar Grid.Column="1" x:Name="DayProgress" VerticalAlignment="Center" Margin="24,0" />
          <TextBlock Grid.Column="2" x:Name="CountsText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- What stands out (Stats), when something does. -->
      <Border x:Name="NoteCard" Style="{StaticResource Card}" Padding="20,12" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ItemsControl x:Name="NoteList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:NoteRow}">
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Brush}" VerticalAlignment="Top" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Grid.Column="1" Content="Stats" Click="Stats_Click" Padding="14,5" VerticalAlignment="Top" Margin="12,0,0,0" />
        </Grid>
      </Border>

      <!-- Food logged by hand today, and about how many kcal the day comes to. -->
      <Border x:Name="FoodCard" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="#B84A0B" VerticalAlignment="Center" Margin="0,1,10,0" />
                <TextBlock x:Name="FoodTitle" Style="{StaticResource Heading}" FontSize="15" />
              </StackPanel>
              <TextBlock x:Name="FoodDetail" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Click="LogFood_Click" Padding="14,5" VerticalAlignment="Center"
                    ToolTip="Something from your kitchen, or eaten out">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                <TextBlock Text="Log food" />
              </StackPanel>
            </Button>
          </Grid>
          <ItemsControl x:Name="FoodList" Focusable="False" Margin="20,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:FoodRow}">
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Kcal}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0" />
                  <Button Grid.Column="3" Style="{StaticResource Bare}" Click="RemoveFood_Click" Padding="6" VerticalAlignment="Center"
                          ToolTip="Take it out of the log (what came off the kitchen goes back)">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="11" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Today's exercise, if it's an exercise day. -->
      <Border x:Name="ExerciseCard" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="#2E7D32" VerticalAlignment="Center" Margin="0,1,10,0" />
              <TextBlock x:Name="ExerciseTitle" Style="{StaticResource Heading}" FontSize="15" />
            </StackPanel>
            <TextBlock x:Name="ExerciseDetail" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,2,0,0" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="ExerciseButton" Content="Start" Click="Exercise_Click" Padding="14,5" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- The kitchen's alerts for today, from the menu. -->
      <Border x:Name="KitchenCard" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,16">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Ellipse Width="10" Height="10" Fill="#B84A0B" VerticalAlignment="Center" Margin="0,1,10,0" />
            <TextBlock Text="In the kitchen today" Style="{StaticResource Heading}" FontSize="15" />
          </StackPanel>
          <ItemsControl x:Name="KitchenList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:KitchenRow}">
                <Grid Margin="0,3" Opacity="{Binding Opacity}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Time}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Center"
                             Foreground="{DynamicResource SystemFillColorSuccessBrush}" Visibility="{Binding Done, Converter={StaticResource VisibleIf}}" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="3" Content="Steps" Click="KitchenSteps_Click" Padding="10,4" VerticalAlignment="Center"
                          Visibility="{Binding HasSteps, Converter={StaticResource VisibleIf}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Nothing yet. -->
      <Border x:Name="Empty" Style="{StaticResource Card}" Padding="32,36">
        <StackPanel HorizontalAlignment="Center" MaxWidth="560">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border Style="{StaticResource Tile}" Width="56" Height="56" Background="{Binding Source={x:Static core:ReminderKind.Pill}, Converter={StaticResource KindBrush}, ConverterParameter=tint}">
              <local:PillView Kind="Pill" Appearance="{x:Static local:TodayPage.SamplePill}" />
            </Border>
            <Border Style="{StaticResource Tile}" Width="56" Height="56" Margin="10,0" Background="{Binding Source={x:Static core:ReminderKind.BloodSugar}, Converter={StaticResource KindBrush}, ConverterParameter=tint}">
              <local:PillView Kind="BloodSugar" />
            </Border>
            <Border Style="{StaticResource Tile}" Width="56" Height="56" Background="{Binding Source={x:Static core:ReminderKind.Drink}, Converter={StaticResource KindBrush}, ConverterParameter=tint}">
              <local:PillView Kind="Drink" />
            </Border>
          </StackPanel>
          <TextBlock Text="Nothing to remind you of yet" Style="{StaticResource Heading}" FontSize="20" HorizontalAlignment="Center" />
          <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,20" Style="{StaticResource Muted}"
                     Text="Add the medications you take, injections, blood sugar tests and other checks, and when. Or let Health Reminder plan when to eat and drink from your height, weight and sex. When something is due, it rings, and for a pill shows you what it looks like." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Add a medication or check" Style="{DynamicResource AccentButtonStyle}" Padding="16,8" Click="Add_Click" Margin="0,0,10,0" />
            <Button Content="Plan meals and drinks" Padding="16,8" Click="Plan_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="NothingToday" Style="{StaticResource Card}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,14,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
          <TextBlock Text="Nothing to do today." FontSize="15" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- The day, by time. -->
      <ItemsControl x:Name="TodayList" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:TodayGroup}">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
              <StackPanel>
                <Grid Margin="20,12,16,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Time}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,1,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="All done" Click="AllDone_Click" ToolTip="Mark everything at this time as done"
                          Visibility="{Binding CanDoAll, Converter={StaticResource VisibleIf}}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TodayItem}">
                      <StackPanel>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="20,10,16,10" MinHeight="48">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Style="{StaticResource Tile}" Width="60" Height="46" Background="{Binding Kind, Converter={StaticResource KindBrush}, ConverterParameter=tint}">
                            <local:PillView Kind="{Binding Kind}" Appearance="{Binding Appearance}" Form="{Binding Form}" Count="{Binding Count}" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                              <Border Style="{StaticResource Chip}" Background="{Binding Kind, Converter={StaticResource KindBrush}}" Margin="10,0,0,0" Padding="6,1,6,2">
                                <TextBlock Text="{Binding KindText}" FontSize="11" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                          </StackPanel>
                          <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{Binding StateBrush}" Margin="0,0,12,0"
                                  Visibility="{Binding HasStateChip, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="{Binding StateText}" />
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                                     Visibility="{Binding HasStateChip, Converter={StaticResource VisibleUnless}}" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                      Visibility="{Binding CanTake, Converter={StaticResource VisibleIf}}">
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,8,0" ToolTip="Reading"
                                     Visibility="{Binding IsCheck, Converter={StaticResource VisibleIf}}" />
                            <Button Content="{Binding DoneText}" MinWidth="96" Click="Done_Click" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
