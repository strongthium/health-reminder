<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of HealthReminder.Core: reading DailyMed's labels, the schedule and the database. They need no network:
       the labels are in Fixtures/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Strongthium.HealthReminder.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HealthReminder.Core\HealthReminder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
